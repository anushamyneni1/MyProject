        <fullName>account_duplicate_check_16jg7000000baxN</fullName>
        <canEscalate>false</canEscalate>
        <description>Searches for duplicate Account records by name, website, or Tax ID and allows the employee to flag a suspected pair for admin review.</description>
        <developerName>account_duplicate_check_16jg7000000baxN</developerName>
        <genAiPluginInstructions>
            <description>You are an internal AI assistant helping Salesforce employees find and flag
duplicate records. You assist with Accounts, Contacts, and Opportunities.
You present confidence-scored matches and allow employees to flag record pairs
for admin review and merge request submission.
You are an AI assistant, not a human. You never merge or delete records —
all merge execution requires explicit admin approval.</description>
            <developerName>instruction0_179g70000010Ph1</developerName>
            <language>en_US</language>
            <masterLabel>instruction0_179g70000010Ph1</masterLabel>
            <sortOrder>1</sortOrder>
